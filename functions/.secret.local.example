# Copy to .secret.local for local validation/emulator use only.
# Deployed functions read Firebase Secret Manager instead.
# Never put these values in Expo .env or EXPO_PUBLIC_* variables.
REVENUECAT_SECRET_API_KEY=
# Random shared token. Dashboard Authorization header: Bearer <token>
# This is not RevenueCat's optional HMAC signing secret.
REVENUECAT_WEBHOOK_SECRET=
