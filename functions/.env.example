# Cloud Functions environment (NOT the Expo app .env).
# Set these in Firebase Console → Functions → Environment variables,
# or via your deploy pipeline — do not commit real values.

# Legacy subscription activation is disabled; the new billing path is below.
# ALLOW_UNVERIFIED_SUBSCRIPTION_GRANT is obsolete and ignored, even if true.
# There is currently no environment switch that enables unverified QA grants.

# Keep off until store setup, webhook delivery, and sandbox tests are complete.
BILLING_ENABLED=false
REVENUECAT_ENTITLEMENT_ID=premium
# Exact REST product IDs, prefixed by store. Replace placeholders in deployment.
# Android IDs may contain a base-plan suffix; use the exact RevenueCat ID.
REVENUECAT_PRODUCT_PLANS={"app_store:REPLACE_IOS_MONTHLY":"monthly","play_store:REPLACE_ANDROID_MONTHLY":"monthly"}
# Enable only in a separate testing Firebase project, never public production.
REVENUECAT_ALLOW_SANDBOX=false

# Set via Firebase Secret Manager, not EXPO_PUBLIC_* or committed files:
# REVENUECAT_SECRET_API_KEY (RevenueCat secret API v1 key)
# REVENUECAT_WEBHOOK_SECRET (random secret; webhook Authorization: Bearer <secret>)
