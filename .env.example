# Copy this file to .env and fill in values from Firebase Console → Project settings → Your apps → Web app config.

# Load Expo Router screens on demand (smaller startup bundle for Expo Go).
EXPO_ROUTER_IMPORT_MODE=lazy
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Support inbox used by Contact Us mailto drafts.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Must match app.json ios.bundleIdentifier / android.package (password-reset ActionCodeSettings).
EXPO_PUBLIC_IOS_BUNDLE_ID=com.calmcourage.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.calmcourage.app

# Hosted Privacy Policy URL for App Store / Google Play listings (required before public submission).
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# Optional hosted Terms of Use URL.
EXPO_PUBLIC_TERMS_OF_USE_URL=

# Enables the simulated paywall purchase for internal QA only.
# Must stay unset/false for App Store and Google Play builds: purchase UI that
# does not charge through IAP violates App Store 3.1.1 and Play payments policy.
# Not pushed by npm run eas:env:sync — set on the EAS dashboard for internal profiles only.
EXPO_PUBLIC_ENABLE_QA_PURCHASE=false

# Native Apple/Google purchases. Enable only in an internal build after backend setup.
EXPO_PUBLIC_ENABLE_STORE_PURCHASES=false
# Public SDK keys only (appl_ / goog_). Never place server secrets here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
